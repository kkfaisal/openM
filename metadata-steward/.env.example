# MetaLens — configuration template.
# Copy to `.env` and adjust. Secrets are never stored in source code.

# --- Catalog backend ---
# "openmetadata" connects to a live OpenMetadata instance (default).
# "demo" uses the seeded local catalog (no external services needed).
CATALOG_BACKEND=openmetadata

# --- OpenMetadata (used when CATALOG_BACKEND=openmetadata) ---
OPENMETADATA_HOST=http://127.0.0.1:8585
OPENMETADATA_EMAIL=admin@open-metadata.org
OPENMETADATA_PASSWORD=admin
# (Optional) A long-lived bot JWT can be used instead of email/password login:
# OPENMETADATA_JWT=

# --- Source PostgreSQL (the ecommerce database the steward operates on) ---
POSTGRES_CONTAINER=om-source-postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=omdev
POSTGRES_DB=ecommerce
# How OpenMetadata (inside Docker) reaches the source Postgres:
POSTGRES_HOST_PORT=host.docker.internal:55432

# --- LLM ---
# "openai" uses the OpenAI-compatible chat API (set OPENAI_API_KEY to enable).
# Falls back to the deterministic heuristic when no key is configured.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenAI-compatible base URL (no trailing slash). Point this at a gateway /
# Azure OpenAI / proxy when the default api.openai.com audio transcription
# endpoint is blocked (e.g. by Zscaler).
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Audio/video transcription ---
# "auto" (default) tries OpenAI whisper-1 then falls back to a local model.
# "openai" = OpenAI only. "local" = local Hugging Face model only.
TRANSCRIPTION_PROVIDER=auto
# Local model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base

# --- Security ---
# Fernet key that encrypts stored connection credentials (required in production).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
METALENS_SECRET_KEY=

# --- Startup ---
# true = create the sample Postgres ecommerce DB, mirror it into OpenMetadata and
# import it (local demos). Use false in production and import datasets in the UI.
BOOTSTRAP_DEMO_DATA=true

# --- RAG knowledge base ---
RAG_ENABLED=true
# Qdrant server (production). Leave empty to use an embedded store at QDRANT_PATH.
QDRANT_URL=
QDRANT_PATH=./data/qdrant
# fastembed (local ONNX, no key) | openai
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_CHUNK_CHARS=800
RAG_MIN_SCORE=0.55

# --- Agent observability (MLflow) ---
# Leave empty to disable tracing. Local: mlflow server --port 5050 (see README).
MLFLOW_TRACKING_URI=
# Browser-facing MLflow URL used for links in the UI (defaults to the tracking URI).
MLFLOW_UI_URL=
MLFLOW_EXPERIMENT=MetaLens Agents
MLFLOW_EVAL_EXPERIMENT=MetaLens Evaluations

# --- Database (the steward's own operational snapshot) ---
DATABASE_URL=sqlite:///./metadata_steward.db

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
